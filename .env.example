# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sistemas_distribuidos
POSTGRES_PORT=5432

# Conexao usada pela aplicacao e pelo Alembic quando rodam fora do Docker.
# Dentro do docker compose o backend recebe DATABASE_URL apontando para o host "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistemas_distribuidos

# Banco usado pelos testes de integracao (criado automaticamente; os dados sao apagados)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistemas_distribuidos_test

# Backend
BACKEND_PORT=8000
