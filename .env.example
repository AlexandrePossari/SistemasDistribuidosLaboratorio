# Copie para .env e ajuste se necessario: cp .env.example .env
# Os valores abaixo sao apenas para desenvolvimento local (nao sao segredos reais).

# Banco de dados (container PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=biblioteca
# Porta publicada na maquina. Troque se a 5432 ja estiver em uso por outro projeto.
POSTGRES_PORT=5432

# Conexao usada pela API quando ela roda fora do Docker (make dev).
# Dentro do docker compose a API recebe DATABASE_URL apontando para o host "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca

# Banco dos testes de integracao (criado automaticamente na primeira execucao)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca_test

# Porta publicada da API. Troque se a 8000 ja estiver em uso por outro projeto.
BACKEND_PORT=8000

# Origens que o navegador pode usar para chamar a API, separadas por virgula.
# Precisam ser explicitas: a API recusa "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
